#!/usr/bin/env python3
"""websearch — a resident llm extension: one tool + one slash command.

Copy to ~/.llm/extensions/websearch, chmod +x, /reload. It mounts:

  web_search {query, limit?}   web search → top titles + URLs
  /web <query>                 run a search straight from the prompt

Search backend: Brave's Search API when BRAVE_API_KEY is set in the
environment (free tier at https://brave.com/search/api — full web
results, official API). Without a key it degrades to a keyless chain:
DuckDuckGo's HTML page, then its Instant Answer JSON, then the Wikipedia
API (encyclopedia scope, always works). The result's first line says
which backend answered.

Page fetching is deliberately not mounted: the built-in `webfetch`
already covers it, so this example mounts only the capability the host
lacks. All extension tools are exec-tier, gated only by the blacklist and
per-tool policies. Protocol: newline-delimited JSON on stdio, one reply per request
id (docs/extensions.md has the reference).
"""

import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
from html import unescape

HEADERS = {
    "User-Agent": "Mozilla/5.0 (compatible; llm-websearch/1.0)",
    "Accept": "text/html,application/xhtml+xml,*/*;q=0.8",
}


def reply(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def http_get(url, timeout=15):
    req = urllib.request.Request(url, headers=HEADERS)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        # refuse binary bodies (pdf/image/zip/...): decoded with errors="replace"
        # they would feed the model mojibake — the built-in webfetch errors by
        # content type for the same reason
        ctype = (r.headers.get("Content-Type") or "").split(";")[0].strip().lower()
        major = ctype.split("/")[0]
        if major in ("image", "audio", "video") or ctype in (
            "application/pdf",
            "application/octet-stream",
            "application/zip",
        ):
            raise ValueError(
                f"binary content ({ctype or 'unknown type'}) — fetch it with bash curl instead"
            )
        return r.read(262144).decode("utf-8", "replace")


def http_get_json(url, timeout=15):
    return json.loads(http_get(url, timeout))


# ----------------------------------------------------------------- search --
def _brave(query, limit):
    key = os.environ.get("BRAVE_API_KEY", "")
    if not key:
        raise RuntimeError("BRAVE_API_KEY not set")
    url = (
        "https://api.search.brave.com/res/v1/web/search?q="
        + urllib.parse.quote_plus(query)
        + "&count="
        + str(min(limit, 20))
    )
    req = urllib.request.Request(
        url,
        headers={
            "X-Subscription-Token": key,
            "Accept": "application/json",
            "Accept-Encoding": "identity",
        },
    )
    try:
        d = json.loads(urllib.request.urlopen(req, timeout=15).read().decode())
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            raise RuntimeError("BRAVE_API_KEY rejected (HTTP %d)" % e.code) from e
        raise
    out = []
    for r in d.get("web", {}).get("results", []):
        desc = re.sub(r"<[^>]+>", "", r.get("description", ""))
        title = r.get("title", "")
        out.append((f"{title} — {unescape(desc)}".strip(" —"), r["url"]))
        if len(out) >= limit:
            break
    return out


def _ddg_unwrap(href):
    """DuckDuckGo wraps result links as //duckduckgo.com/l/?uddg=<encoded>."""
    if "uddg=" in href:
        href = urllib.parse.unquote(href.split("uddg=", 1)[1].split("&", 1)[0])
    if href.startswith("//"):
        href = "https:" + href
    return href


def _ddg_html(query, limit):
    page = http_get("https://html.duckduckgo.com/html/?q=" + urllib.parse.quote_plus(query))
    out = []
    for m in re.finditer(r'class="result__a"[^>]*href="([^"]+)"[^>]*>(.*?)</a>', page, re.S):
        title = re.sub(r"<[^>]+>", "", m.group(2))
        out.append((unescape(title).strip(), _ddg_unwrap(m.group(1))))
        if len(out) >= limit:
            break
    return out


def _ddg_instant(query, limit):
    d = http_get_json(
        "https://api.duckduckgo.com/?q="
        + urllib.parse.quote_plus(query)
        + "&format=json&no_html=1&skip_disambig=1"
    )
    out = []

    def walk(topics):
        for t in topics:
            if "FirstURL" in t and len(out) < limit:
                out.append((t.get("Text", ""), t["FirstURL"]))
            walk(t.get("Topics", []))

    walk(d.get("RelatedTopics", []))
    return out


def _wikipedia(query, limit):
    d = http_get_json(
        "https://en.wikipedia.org/w/api.php?action=query&list=search&srlimit="
        + str(limit)
        + "&srsearch="
        + urllib.parse.quote_plus(query)
        + "&format=json"
    )
    return [
        (h["title"], "https://en.wikipedia.org/wiki/" + h["title"].replace(" ", "_"))
        for h in d.get("query", {}).get("search", [])[:limit]
    ]


BACKENDS = [
    ("brave", _brave),
    ("duckduckgo", _ddg_html),
    ("duckduckgo instant answers", _ddg_instant),
    ("wikipedia (encyclopedia only)", _wikipedia),
]


def web_search(query, limit=5):
    if not query.strip():
        return "error: empty query"
    errors = []
    for label, backend in BACKENDS:
        try:
            results = backend(query, limit)
        except Exception as e:
            errors.append(f"{label}: {e}")
            continue
        if results:
            lines = [f"via {label}"] + [
                f"{i}. {title}\n   {url}" for i, (title, url) in enumerate(results, 1)
            ]
            return "\n".join(lines)
    hint = "" if os.environ.get("BRAVE_API_KEY") else (
        "\n(set BRAVE_API_KEY for full Brave web search; free tier at "
        "https://brave.com/search/api)"
    )
    note = f" ({'; '.join(errors)})" if errors else ""
    return f"no results for {query!r}{note}{hint}"


# ------------------------------------------------------------------- main --
TOOLS = [
    {
        "name": "web_search",
        "description": "Search the web and return the top result titles and "
        "URLs (Brave Search API when BRAVE_API_KEY is set, keyless "
        "DuckDuckGo/Wikipedia fallback otherwise)",
        "parameters": {
            "type": "object",
            "properties": {
                "query": {"type": "string", "description": "the search query"},
                "limit": {
                    "type": "integer",
                    "description": "max results (default 5)",
                },
            },
            "required": ["query"],
        },
    },
]


def main():
    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue
        mid, kind = msg.get("id"), msg.get("type")
        if kind == "initialize":
            reply({"id": mid, "result": {"tools": TOOLS, "commands": ["web"], "events": []}})
        elif kind == "call_tool":
            args = msg.get("args") or {}
            try:
                if msg.get("name") == "web_search":
                    out = web_search(str(args.get("query", "")), int(args.get("limit") or 5))
                else:
                    out = f"unknown tool {msg.get('name')}"
                reply({"id": mid, "result": out})
            except Exception as e:  # network errors become tool errors
                reply({"id": mid, "error": f"{type(e).__name__}: {e}"})
        elif kind == "run_command" and msg.get("name") == "web":
            try:
                reply({"id": mid, "result": web_search(str(msg.get("args") or "").strip())})
            except Exception as e:
                reply({"id": mid, "result": f"search failed: {e}"})
        elif kind == "shutdown":
            return


if __name__ == "__main__":
    main()
