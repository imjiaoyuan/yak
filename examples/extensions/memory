#!/usr/bin/env python3
"""memory — a resident yak extension: one tool, one file (the former remember).

Copy to ~/.yak/extensions/memory, chmod +x, /reload. It mounts:

  memory {text}               one dated line into the user's global memory
  memory {text} project=true   the same line into the project's memory

Global memory is <user_dir>/YAK.md (YAK_USER_PATH overrides the whole user
dir, else ~/.yak); project memory is <project>/.yak/YAK.md — the nearest
.yak walking up from cwd, bounded by the git root, the same walk the
project's config and blacklist follow. Both files are injected into the
system prompt (the <user_memory> and <project_memory> blocks), so a line
added here rides every future session — global ones everywhere, project
ones inside that project. This is the built-in memory tool on the
extension surface (renamed from remember); otherwise byte-compatible with its
former self. Write-tier: it
mutates one file and runs nothing. Protocol: newline-delimited JSON on
stdio, one reply per request id (docs/extensions.md has the reference).
"""

import json
import os
import sys
import time

DESCRIPTION = (
    "Save one durable fact to memory, injected into every future session. "
    "Global by default (the user's YAK.md, all projects); pass project=true "
    "for a fact only this project's sessions need (its .yak/YAK.md). Only "
    "when the user explicitly asks to remember/note something, or a fact is "
    "clearly durable (a preference, an environment constant, a way of "
    "working that future sessions must obey). Test before writing: will the "
    "next session in a different project still need this? One-off task "
    "facts (what was done, verified or fixed just now) fail that test — "
    "never record them."
)

TOOLS = [
    {
        "name": "memory",
        "description": DESCRIPTION,
        "parameters": {
            "type": "object",
            "properties": {
                "text": {
                    "type": "string",
                    "description": "The fact to record, one line",
                },
                "project": {
                    "type": "boolean",
                    "description": (
                        "Write to this project's .yak/YAK.md instead of the "
                        "global memory (default false)"
                    ),
                },
            },
            "required": ["text"],
        },
        "tier": "write",
    },
]


def reply(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def user_dir():
    """config::user_dir(): YAK_USER_PATH wins, else ~/.yak (HOME else
    USERPROFILE on Windows). The migration the Rust side runs is a one-time
    startup rename, not a per-write concern."""
    override = os.environ.get("YAK_USER_PATH")
    if override:
        return override
    home = os.environ.get("HOME") or (
        os.environ.get("USERPROFILE") if os.name == "nt" else None
    )
    return os.path.join(home, ".yak") if home else os.path.join(".yak")


def project_yak_dir():
    """paths::nearest_dir_up(cwd, ".yak", stop_at_git_root): the nearest
    .yak walking up from the process cwd (the host spawns extensions in the
    agent's working directory), never past a .git root."""
    cwd = os.getcwd()
    parts = cwd.split(os.sep)
    for i in range(len(parts), 0, -1):
        d = os.sep.join(parts[:i]) or os.sep
        if os.path.isdir(os.path.join(d, ".yak")):
            return os.path.join(d, ".yak")
        if os.path.exists(os.path.join(d, ".git")):
            return None
        if d == os.sep:
            break
    return None


def rust_trim(s, chars=('"', ".")):
    """str::trim_matches(['"', '.']): both characters, both ends,
    repeatedly — and nothing else (spaces survive)."""
    start, end = 0, len(s)
    while start < end and s[start] in chars:
        start += 1
    while end > start and s[end - 1] in chars:
        end -= 1
    return s[start:end]


def rust_lines(text):
    """str::lines(): no trailing empty piece, "" has no lines."""
    if text == "":
        return []
    lines = text.split("\n")
    if text.endswith("\n"):
        lines = lines[:-1]
    return lines


def remember_at(path, line):
    """One dated deduped line into a memory file. Returns (wrote, error): wrote is False when the
    line dedups or trims away, error carries the io failure."""
    line = rust_trim(line.strip())
    if not line:
        return False, None
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        text = ""
    lower = line.lower()
    for l in rust_lines(text):
        ll = l.lower()
        if lower in ll or ll in lower:
            return False, None
    # a hand-edited file may lack the trailing newline; never glue lines
    if text and not text.endswith("\n"):
        text += "\n"
    today = time.strftime("%Y-%m-%d", time.gmtime(time.time()))
    text += f"- [{today}] {line}\n"
    try:
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(text)
    except OSError as e:
        return None, f"{type(e).__name__}: {e}"
    return True, None


def main():
    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue
        mid, kind = msg.get("id"), msg.get("type")
        if kind == "initialize":
            reply({"id": mid, "result": {"tools": TOOLS, "commands": [], "events": []}})
        elif kind == "call_tool":
            if msg.get("name") != "memory":
                reply({"id": mid, "error": f"unknown tool {msg.get('name')}"})
                continue
            args = msg.get("args") or {}
            # validation already ran host-side; a non-string still takes the
            # built-in's None → "" path
            text = args.get("text")
            text = text if isinstance(text, str) else ""
            if not text.strip():
                reply({"id": mid, "error": "nothing to record"})
                continue
            if args.get("project"):
                yak_dir = project_yak_dir()
                if not yak_dir:
                    reply(
                        {
                            "id": mid,
                            "error": (
                                "no .yak directory up from cwd (bounded by "
                                "the git root) — create one first: mkdir .yak"
                            ),
                        }
                    )
                    continue
                path = os.path.join(yak_dir, "YAK.md")
                scope = f"project memory ({path})"
            else:
                path = os.path.join(user_dir(), "YAK.md")
                scope = "memory"
            try:
                wrote, err = remember_at(path, text)
            except Exception as e:  # parity with the Rust error path
                reply({"id": mid, "error": f"cannot write {scope}: {e}"})
                continue
            if err is not None:
                reply({"id": mid, "error": f"cannot write {scope}: {err}"})
            elif wrote:
                reply(
                    {
                        "id": mid,
                        "result": (
                            f"noted in {scope} — it will apply from the "
                            "next session on"
                        ),
                    }
                )
            else:
                reply({"id": mid, "result": "already in memory"})
        elif kind == "shutdown":
            return


if __name__ == "__main__":
    main()
