#!/usr/bin/env python3
"""model_pin — a resident yak extension: no commands, one file.

Copy to ~/.yak/extensions/model_pin, chmod +x, /reload. It listens to
`agent_start` and writes `<cwd>: <model>` into `<user_dir>/model-pins.json`
—the table yak's startup model resolution already reads (the nearest
pinned ancestor of cwd wins). Every task thus records the model it ran on
for its directory, and the next yak started there picks it up. `/model`
changes the global default and the current session; this extension separately
remembers the current directory when its next task starts. The core reads
this table but never writes directory pins.

No slash command: to stop remembering in a project, delete the entry (or
the file); to pin a directory you never run tasks in, write the JSON by
hand. Removing the extension leaves the core reading the same file.

`agent_start` is an observational event: it carries no reply, and a
broken pins table is reported on stderr (the host's diagnostics tail)
instead of vanishing.
"""

import json
import os
import sys


def reply(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def user_dir():
    """config::user_dir(): YAK_USER_PATH wins, else ~/.yak. The initialize
    handshake carries the same path; the env fallback covers a test that
    talks the protocol without one."""
    override = os.environ.get("YAK_USER_PATH")
    if override:
        return override
    home = os.environ.get("HOME") or (
        os.environ.get("USERPROFILE") if os.name == "nt" else None
    )
    return os.path.join(home, ".yak") if home else os.path.join(".yak")


def pins_path():
    return os.path.join(user_dir(), "model-pins.json")


def record(cwd, model):
    path = pins_path()
    try:
        with open(path, encoding="utf-8") as f:
            pins = json.load(f)
    except OSError:
        pins = {}
    except json.JSONDecodeError as e:
        raise SystemExit(f"error: {path} does not parse: {e}")
    if pins.get(cwd) == model:
        return
    pins[cwd] = model
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(pins, f, indent=2)
        f.write("\n")


def main():
    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue
        mid, kind = msg.get("id"), msg.get("type")
        if kind == "initialize":
            reply({"id": mid, "result": {"events": ["agent_start"]}})
        elif kind == "event" and msg.get("name") == "agent_start":
            p = msg.get("params") or {}
            cwd, model = p.get("cwd"), p.get("model")
            if cwd and model:
                try:
                    record(cwd, model)
                except (SystemExit, OSError) as e:
                    sys.stderr.write(f"model_pin: {e}\n")
        elif kind == "shutdown":
            return


if __name__ == "__main__":
    main()
