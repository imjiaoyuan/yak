#!/usr/bin/env python3
"""plan — a resident yak extension: one checklist tool.

The checklist is preserved by the generic compact hook. The host supplies the
soon-to-be-dropped tool results, so this also works after restart and resume;
the extension owns the knowledge that its own ``plan`` result is authoritative.
"""

import json
import sys

DESCRIPTION = (
    "Update the task plan: a list of steps, each with a `step` and a "
    "`status` (`pending`, `in_progress`, `completed`); at most one "
    "`in_progress` at a time."
)

TOOLS = [
    {
        "name": "plan",
        "description": DESCRIPTION,
        "parameters": {
            "type": "object",
            "properties": {
                "plan": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "step": {"type": "string", "description": "Step text"},
                            "status": {
                                "type": "string",
                                "enum": ["pending", "in_progress", "completed"],
                                "description": "Status",
                            },
                        },
                        "required": ["step", "status"],
                    },
                }
            },
            "required": ["plan"],
        },
        "tier": "read",
    },
]


def reply(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def short(text, max_chars=60):
    if len(text) <= max_chars:
        return text
    return text[:max_chars] + "…"


def validate_plan(args):
    plan = args.get("plan")
    if not isinstance(plan, list):
        return "`plan` must be an array of {step, status} objects"
    if not plan:
        return "`plan` must contain at least one step"
    in_progress = 0
    for i, item in enumerate(plan, start=1):
        if not isinstance(item, dict):
            return f"plan step {i} is missing its `step` text"
        step = item.get("step")
        if not isinstance(step, str) or not step.strip():
            return f"plan step {i} is missing its `step` text"
        status = item.get("status")
        if status in ("pending", "completed"):
            pass
        elif status == "in_progress":
            in_progress += 1
        elif isinstance(status, str):
            return f"plan step {i} has unknown status '{status}' (use pending, in_progress or completed)"
        else:
            return f"plan step {i} is missing its `status`"
    if in_progress > 1:
        return f"at most one step may be in_progress at a time, got {in_progress}"
    return None


def render_plan(args):
    lines = []
    for item in args.get("plan", []):
        status = item.get("status")
        mark = "[x]" if status == "completed" else "[>]" if status == "in_progress" else "[ ]"
        lines.append(f"{mark} {item.get('step', '').strip()}")
    return "\n".join(lines)


def summary(args):
    plan = args.get("plan")
    done = sum(1 for step in plan if step.get("status") == "completed")
    active = next((step.get("step") for step in plan if step.get("status") == "in_progress"), None)
    word = "step" if len(plan) == 1 else "steps"
    text = f"{len(plan)} {word} · {done} done"
    if isinstance(active, str):
        text += f" · now: {short(active.strip())}"
    return text


def preserved(params):
    for item in reversed(params.get("dropped_tool_results") or []):
        if item.get("tool") in ("plan", "update_plan") and item.get("content", "").strip():
            return {
                "preserved": [
                    {"label": "active task list", "content": item["content"]}
                ]
            }
    return {}


def main():
    for line in sys.stdin:
        try:
            message = json.loads(line)
        except ValueError:
            continue
        mid, kind = message.get("id"), message.get("type")
        if kind == "initialize":
            reply({"id": mid, "result": {"tools": TOOLS, "commands": [], "events": ["compact"]}})
        elif kind == "event" and message.get("name") == "compact":
            reply({"id": mid, "result": preserved(message.get("params") or {})})
        elif kind == "call_tool":
            args = message.get("args") or {}
            if message.get("name") != "plan":
                reply({"id": mid, "error": f"unknown tool {message.get('name')}"})
                continue
            error = validate_plan(args)
            if error:
                reply({"id": mid, "error": error})
                continue
            sys.stdout.write(json.dumps({"type": "lane", "v": 1, "lane": "plan", "text": summary(args)}) + "\n")
            sys.stdout.flush()
            reply({"id": mid, "result": render_plan(args)})
        elif kind == "shutdown":
            return


if __name__ == "__main__":
    main()
